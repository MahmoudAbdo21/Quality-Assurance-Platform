generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                       String             @id @default(cuid())
  username                 String             @unique
  displayName              String
  passwordHash             String
  role                     String             @default("SUPER_ADMIN")
  isActive                 Boolean            @default(true)
  failedLoginCount         Int                @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  sessionVersion           Int                @default(1)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  createdCertificateIssues CertificateIssue[]
}

model Course {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  summary          String
  description      String
  displayOrder     Int      @default(0)
  isPublished      Boolean  @default(true)
  isSuspended      Boolean  @default(false)
  suspensionReason String?
  imageAssetId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  certificate   Certificate[]
  registrations CourseRegistration[]
  imageAsset    MediaAsset?          @relation("CourseImage", fields: [imageAssetId], references: [id])
}

model Certificate {
  id               String   @id @default(cuid())
  courseId         String
  title            String
  description      String
  certificateBody  String
  displayOrder     Int      @default(0)
  isPublished      Boolean  @default(true)
  isSuspended      Boolean  @default(false)
  suspensionReason String?
  imageAssetId     String?
  fileAssetId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  imageAsset MediaAsset?        @relation("CertificateImage", fields: [imageAssetId], references: [id])
  fileAsset  MediaAsset?        @relation("CertificateFile", fields: [fileAssetId], references: [id])
  issues     CertificateIssue[]
}

model Visitor {
  id            String               @id @default(cuid())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  registrations CourseRegistration[]
  likes         ForumLike[]
}

model CourseRegistration {
  id              String   @id @default(cuid())
  publicToken     String   @unique
  visitorId       String
  courseId        String
  fullName        String
  age             Int
  faculty         String
  department      String
  promotionDegree String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  visitor           Visitor            @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  course            Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  certificateIssues CertificateIssue[]

  @@unique([visitorId, courseId])
}

model ForumTopic {
  id         String         @id @default(cuid())
  authorName String
  title      String
  content    String
  isVisible  Boolean        @default(true)
  isLocked   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  comments   ForumComment[]
  likes      ForumLike[]
}

model ForumComment {
  id         String   @id @default(cuid())
  topicId    String
  authorName String
  content    String
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model ForumLike {
  id        String   @id @default(cuid())
  topicId   String
  visitorId String
  createdAt DateTime @default(now())

  topic   ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  visitor Visitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@unique([topicId, visitorId])
}

model ContactMessage {
  id         String    @id @default(cuid())
  fullName   String
  email      String
  message    String
  status     String    @default("NEW") // NEW, READ, ARCHIVED
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  archivedAt DateTime?
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model KnowledgeSlide {
  id           String   @id @default(cuid())
  title        String
  content      String
  displayOrder Int      @default(0)
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteSettings {
  id                      String   @id @default(cuid())
  siteTitle               String   @default("منصة ضمان الجودة والاعتماد الأكاديمي - جامعة الأزهر")
  siteSubtitle            String   @default("نظام متكامل للاعتماد الأكاديمي")
  heroBadge               String   @default("التميز في التعليم")
  heroTitle               String   @default("نحو تعليم معتمد ومستقبل مشرق")
  heroHighlightedText     String   @default("معتمد")
  heroDescription         String   @default("الهيئة القومية لضمان جودة التعليم والاعتماد هي الجهة المسؤولة عن نشر ثقافة الجودة وتقييم واعتماد المؤسسات التعليمية للارتقاء بمستوى التعليم في مصر.")
  heroPrimaryButtonText   String   @default("اكتشف دوراتنا")
  heroSecondaryButtonText String   @default("تعرف علينا أكثر")
  aboutIntro              String   @default("منصة أكاديمية رائدة مخصصة لنشر ثقافة الجودة الشاملة والاعتماد المؤسسي وفقاً لأعلى المعايير الوطنية والدولية.")
  visionTitle             String   @default("رؤيتنا")
  visionContent           String   @default("الريادة والتميز في تمكين المؤسسات التعليمية والأكاديمية من تطبيق أعلى معايير الجودة الشاملة والاعتماد الأكاديمي للوصول إلى مستويات التنافسية العالمية.")
  missionTitle            String   @default("رسالتنا")
  missionContent          String   @default("توفير برامج تدريبية متطورة، ونظم تقييم دقيقة، وبيئة تفاعلية متكاملة للارتقاء بمهارات الكوادر الأكاديمية وبناء مجتمع معرفي قائم على التحسين المستمر والتميز المؤسسي.")
  contactAddress          String   @default("١٢ شارع الجودة، مدينة نصر، القاهرة، جمهورية مصر العربية")
  contactPhone            String   @default("+20 2 2345 6789")
  contactEmail            String   @default("info@naqaae.eg")
  footerDescription       String   @default("المظلة الرسمية لضمان جودة التعليم في مصر والارتقاء به لمستوى المعايير الدولية.")
  copyrightText           String   @default("جميع الحقوق محفوظة © ٢٠٢٤ الهيئة القومية لضمان جودة التعليم والاعتماد.")
  privacyText             String   @default("سياسة الخصوصية للمنصة")
  termsText               String   @default("شروط الاستخدام والأحكام")
  facebookUrl             String   @default("#")
  xUrl                    String   @default("#")
  youtubeUrl              String   @default("#")
  linkedinUrl             String   @default("#")
  updatedAt               DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  relativePath String
  createdAt    DateTime @default(now())

  courseImages      Course[]      @relation("CourseImage")
  certificateImages Certificate[] @relation("CertificateImage")
  certificateFiles  Certificate[] @relation("CertificateFile")
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String?
  action      String
  entityType  String
  entityId    String?
  summary     String
  ipAddress   String?
  createdAt   DateTime @default(now())
}

model CertificateIssue {
  id String @id @default(cuid())

  certificateId String
  certificate   Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  registrationId String?
  registration   CourseRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  recipientFullName     String
  recipientTitle        String?
  recipientFaculty      String?
  recipientDepartment   String?
  recipientOrganization String?
  recipientEmail        String?
  recipientReference    String?

  issueDate      DateTime
  completionDate DateTime?
  trainingHours  Int?
  grade          String?
  notes          String?

  serialNumber      String @unique
  verificationToken String @unique

  status           String    @default("ISSUED")
  revokedAt        DateTime?
  revocationReason String?

  certificateTitleSnapshot String
  certificateBodySnapshot  String
  courseTitleSnapshot      String
  templateDesignSnapshot   String?
  customFieldsJson         String?

  createdByAdminUserId String?
  createdByAdminUser   AdminUser? @relation(fields: [createdByAdminUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([certificateId])
  @@index([registrationId])
  @@index([recipientFullName])
  @@index([serialNumber])
  @@index([status])
  @@index([issueDate])
}
